# Copy to .env and adjust. Values below are the ones supplied for the QA environment.
BASE_URL=http://136.83.129.92:8081
API_URL=http://136.83.129.92:8081/api
API_KEY=qa-insurance-demo-token-123
PASSWORD=Password@123


PASSWORD_AGENT_VALID=Qa#Insure2026xyz!
USER_VALID=agent.valid@insurance.test
USER_NEW=agent.new@insurance.test
USER_DRAFT=agent.draft@insurance.test
USER_SUBMITTED=agent.submitted@insurance.test
USER_LOCKED=agent.locked@insurance.test
# learner001@insurance.test ... learner030@insurance.test are used for destructive tests (lockout)
LEARNER_PREFIX=learner
LEARNER_DOMAIN=insurance.test

# ---- UI conventions (adjust if the real UI differs) ----
# Format used when typing a date into a text (non type=date) input: tokens YYYY MM DD
DATE_FORMAT=YYYY-MM-DD
# Failed login attempts before lockout (NOT documented - set once known, otherwise lockout tests are skipped)
LOCKOUT_THRESHOLD=
# ---- Business rule values (NOT supplied - tests needing them are skipped until set) ----
PRODUCT_NAME=Whole Life
FACE_VALUE_VALID=500000
FACE_VALUE_MIN=
FACE_VALUE_MAX=
MAX_UPLOAD_MB=
MAX_RIDERS=
RIDER_NAME=
EXCLUSIVE_RIDER_A=
EXCLUSIVE_RIDER_B=
DEPENDENT_RIDER=
PREREQUISITE_RIDER=
# ---- API paths (assumed - override with the real contract) ----
API_LOGIN=/auth/login
API_LOGOUT=/auth/logout
API_APPLICATIONS=/applications
API_CLIENT=/applications/{id}/client
API_ADDRESS=/applications/{id}/address-contact
API_KYC=/applications/{id}/kyc-financial
API_PRODUCT=/applications/{id}/product
API_RIDERS=/applications/{id}/riders
API_BENEFICIARIES=/applications/{id}/beneficiaries
API_DOCUMENTS=/applications/{id}/documents
API_VALIDATE=/applications/{id}/validate
API_SUBMIT=/applications/{id}/submit
API_STATUS=/applications/{id}/status
# Run on more browsers: BROWSERS=all
